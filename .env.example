# ===================================================================
# == MirrorMessiah Production Environment Configuration
# ===================================================================
#
# Create a file named '.env' in this directory and copy the contents below.
#
# ===================================================================

# --- Authentication Keys ---
# GATE_KEY: The primary key for family/users to browse and watch movies.
GATE_KEY=your_gate_key_here

# ADMIN_KEY: The key for administrative functions. 
# Restricted to local development for management tools, but serves as master login in production.
ADMIN_KEY=your_admin_key_here

# --- Network & Deployment ---
# By default the app is served on the local network only (no internet exposure):
#   docker compose up -d   ->   http://<this-machine-LAN-IP>  (also :3000)
# Interface to publish on: 0.0.0.0 = all LAN interfaces, a single LAN IP, or 127.0.0.1 = this machine only.
BIND_ADDR=0.0.0.0
# Port 80 lets TVs and phones open the app without typing a port; APP_PORT_ALT keeps :3000 working.
# The two must be different.
APP_PORT=80
APP_PORT_ALT=3000

# Keep false for plain-HTTP LAN access (browsers drop Secure cookies over HTTP, breaking login).
# Set to true when serving over HTTPS, e.g. through the Cloudflare tunnel.
COOKIE_SECURE=false

# The URL users open. If not set, defaults to http://localhost:3000
NEXTAUTH_URL=http://192.168.1.50:3000

# Optional: Cloudflare Tunnel Token for internet access.
# Get this from the Zero Trust Dashboard -> Access -> Tunnels
# Only used when started with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Optional: parent folder mounted in Docker when movies and courses are on different drives
# (e.g. both under /media/tushita/TUSHITA_W11_DATA and /media/tushita/TUSHITA_LINUX_DATA).
MEDIA_ROOT=/media/tushita

# Path to your movie collection on the host machine.
MEDIA_DIR=/path/to/your/movies

# Path to your series collection.
SERIES_DIR=/path/to/your/series

# Path to your courses collection (Udemy, Rebelway, Pikuma, etc.).
COURSES_DIR=/path/to/your/courses

# Optional: legacy course roots still on another drive (colon-separated).
LEGACY_COURSES_DIRS=/path/to/legacy/courses

# --- TMDB (Optional: movie/series metadata scraping) ---
# Leave blank to run without scraping; the "Scrape from TMDB" buttons will return an error.
TMDB_API_KEY=

# --- OpenSubtitles (Optional: for mm.py fetch-subs) ---
# Register at https://www.opensubtitles.com/en/consumers
# Enable "dev_mode" on your consumer key for 100 test downloads/day (no login required).
OPENSUBS_API_KEY=your_opensubs_api_key
OPENSUBS_USERNAME=your_opensubs_username
OPENSUBS_PASSWORD=your_opensubs_password
# Skip login during testing so fetch-subs uses the API key dev_mode quota (100/day).
# Set to 0 after subscribing if you want account/VIP quota via login instead.
OPENSUBS_DEV_MODE=1

# --- Gemini (Optional: for courses_cli scrape metadata) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Default model for metadata scrape (gemini-2.0-flash is retired)
GEMINI_MODEL=gemini-2.5-flash

# --- NAS deploy (scripts/deploy_to_nas.sh) ---
# SSH target and the folder on the NAS holding this app's docker-compose.yml + .env
NAS_SERVER=root@shambala.local
NAS_APP_DIR=/srv/your-disk/apps/mirrormessiah
NAS_PORT=6600

